{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commit": true,
    "commitMessage": "chore: release v${version}",
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "push": false
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": "yarn typecheck && yarn lint",
    "after:bump": "yarn build",
    "after:release": "echo Local release prepared for ${name} v${version}. Run: git push --follow-tags origin main"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features",
            "effect": "bump"
          },
          {
            "type": "fix",
            "section": "Bug Fixes",
            "effect": "bump"
          },
          {
            "type": "perf",
            "section": "Performance",
            "effect": "bump"
          },
          {
            "type": "refactor",
            "section": "Refactor",
            "effect": "changelog"
          },
          {
            "type": "docs",
            "section": "Documentation",
            "effect": "changelog"
          },
          {
            "type": "chore",
            "effect": "hidden"
          },
          {
            "type": "style",
            "effect": "hidden"
          },
          {
            "type": "ci",
            "effect": "hidden"
          },
          {
            "type": "test",
            "effect": "hidden"
          },
          {
            "type": "build",
            "effect": "hidden"
          },
          {
            "type": "revert",
            "effect": "hidden"
          }
        ]
      },
      "infile": "CHANGELOG.md"
    }
  }
}
