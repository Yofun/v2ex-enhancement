{
  "name": "v2ex-enhancement",
  "version": "0.2.0",
  "private": true,
  "description": "V2EX 增强脚本：列表预览、楼中楼评论、标签、签到等（基于 V2Next 还原为 React + TypeScript）",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "test": "node scripts/fetch-fixtures.mjs && vitest run",
    "e2e": "node scripts/fetch-fixtures.mjs && yarn build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "postinstall": "husky"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@release-it/conventional-changelog": "^8.0.2",
    "@types/jsdom": "^30",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "release-it": "^17.11.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^5.0.5"
  }
}
